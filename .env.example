STOAT_BOT_TOKEN=BURAYA_BOT_TOKEN
PREFIX=!
# Kendi Stoat sunucunuzun API adresi (resmî sunucu için https://stoat.chat/api)
STOAT_API_URL=https://stoat.example.com/api

# Kelime aramasında sırayla denenecek kaynaklar (biri bulamazsa sıradakine geçer).
# Kullanılabilir: soundcloud, audius, bandcamp, mixcloud, archive, youtube
MUSIC_SOURCES=soundcloud,audius,bandcamp,mixcloud,archive

# YouTube açılırsa (MUSIC_SOURCES'a youtube eklenirse) isteğe bağlı cookie dosyası yolu.
# YTDLP_COOKIES=/app/cookies.txt
